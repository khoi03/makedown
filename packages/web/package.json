{
  "name": "@makedown/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "description": "Makedown collaborative web workbench (editor + DAG + inspector).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist",
    "test": "vitest run --passWithNoTests",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.3.1",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.36.1",
    "@xyflow/react": "^12.4.2",
    "codemirror": "^6.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "y-codemirror.next": "^0.3.5",
    "y-protocols": "^1.0.6",
    "y-websocket": "^2.1.0",
    "yjs": "^13.6.20"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "vite": "^5.4.11"
  },
  "keywords": [
    "llm",
    "ai",
    "build-system",
    "makefile",
    "markdown",
    "incremental",
    "content-addressed",
    "dag",
    "provenance"
  ],
  "homepage": "https://github.com/khoi03/makedown#readme",
  "bugs": "https://github.com/khoi03/makedown/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/khoi03/makedown.git",
    "directory": "packages/web"
  },
  "author": "khoi03"
}
