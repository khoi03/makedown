# Copy to `.env` in this folder and fill in. See the repo-root `.env.example` for
# all options (OpenRouter, Groq, Ollama, gateways, etc.).
#
# Planning (status/cost/why/graph) and the `extract` transform need NO key.
# The `summary` (chat) and `memo` (agent) steps need a credential below.
#
# The `memo` target additionally needs:
#   1. the agent runtime installed:  npm install @anthropic-ai/claude-agent-sdk
#   2. a git repo with at least one commit (the worktree sandbox checks out HEAD)

ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
# ANTHROPIC_BASE_URL=https://your-gateway.example/anthropic

# The `summary` fallback chain also lists an OpenAI model; set this to exercise it.
# OPENAI_API_KEY=sk-xxxxxxxx
