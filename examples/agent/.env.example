# Copy to `.env` in this folder and fill in. See the repo-root .env.example for
# all options (OpenRouter, Groq, Ollama, gateways, etc.).
#
# The `implement` target runs a coding agent. It needs BOTH:
#   1. the agent runtime installed:  npm install @anthropic-ai/claude-agent-sdk
#   2. a credential the runtime can read (set one of the below)
# and the workspace must be a git repo with at least one commit (worktree sandbox).

ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
# ANTHROPIC_BASE_URL=https://your-gateway.example/anthropic
# MAKEDOWN_DEFAULT_PROVIDER=anthropic
