# Copy to `.env` in this folder. To run all three targets you need both an
# Anthropic key and an OpenAI-compatible key. For the `local` target, point
# OPENAI_BASE_URL at a local Ollama server.

ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

OPENAI_API_KEY=sk-xxxxxxxx
OPENAI_BASE_URL=https://api.openai.com/v1
#   OpenRouter: https://openrouter.ai/api/v1
#   Ollama:     http://localhost:11434/v1   (OPENAI_API_KEY can be "ollama")
