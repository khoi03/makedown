# Copy to `.env` in this folder.
#
# The `resilient` and `cheapest-first` targets need only an Anthropic key.
# The `resilient` target's last fallback (openai:gpt-5) additionally needs an
# OpenAI-compatible key — omit it and that candidate is simply skipped.
#
# Swap the model ids in build.md for ones your keys can access. The
# `forced-fallback` target intentionally uses a non-existent primary model to
# demonstrate a real fallback, so it needs no special setup.

ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# Optional — only for the openai:gpt-5 fallback candidate.
OPENAI_API_KEY=sk-xxxxxxxx
OPENAI_BASE_URL=https://api.openai.com/v1
#   OpenRouter: https://openrouter.ai/api/v1
#   Ollama:     http://localhost:11434/v1   (OPENAI_API_KEY can be "ollama")
