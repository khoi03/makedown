# Copy to `.env` in this folder and fill in. See the repo-root .env.example for
# all options (OpenRouter, Groq, Ollama, etc.).
#
# `topic-list` (a transform) runs with no key. The map/chat/eval targets need
# a provider — set one of the below, then `md build examples/phase1`.

ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
# OPENAI_API_KEY=sk-xxxxxxxx
# OPENAI_BASE_URL=https://api.openai.com/v1
# MAKEDOWN_DEFAULT_PROVIDER=anthropic
