{
  "name": "makedown-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Make for LLM workflows — a collaborative Markdown workspace where LLM/agent outputs are content-addressed, incrementally-rebuilt build artifacts.",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:scripts": "vitest run scripts",
    "lint": "pnpm -r lint",
    "lint:deps": "node scripts/check-deps.mjs",
    "clean": "pnpm -r clean",
    "md": "pnpm --filter @makedown/cli exec md"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.172",
    "@types/node": "^22.7.0",
    "@vitest/coverage-v8": "2.1.9",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
