{
  "name": "@makedown/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "description": "[COMMERCIAL] Cloud API: auth, billing, hosting, team RBAC, shared artifact CDN. Not Apache-2.0.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "makedown-server": "./dist/main.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "clean": "tsc -b --clean",
    "start": "node dist/main.js",
    "dev": "node --watch dist/main.js",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@makedown/agents": "workspace:*",
    "@makedown/engine": "workspace:*",
    "@makedown/format": "workspace:*",
    "@makedown/providers": "workspace:*",
    "@makedown/shared": "workspace:*",
    "@makedown/sync": "workspace:*",
    "fastify": "^5.1.0",
    "ws": "^8.18.0",
    "yjs": "^13.6.20"
  },
  "devDependencies": {
    "@types/ws": "^8.5.13",
    "y-protocols": "^1.0.6"
  }
}
