{
  "name": "@makedown/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "description": "Makedown server: Fastify API, build orchestration, snapshots, sharing, and optional teams.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "makedown-server": "./dist/main.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "clean": "tsc -b --clean",
    "start": "tsc -b && node dist/main.js",
    "dev": "tsc -b && node --watch dist/main.js",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@makedown/agents": "workspace:*",
    "@makedown/engine": "workspace:*",
    "@makedown/format": "workspace:*",
    "@makedown/import": "workspace:*",
    "@makedown/providers": "workspace:*",
    "@makedown/shared": "workspace:*",
    "@makedown/sync": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.1.0",
    "marked": "^18.0.5",
    "postgres": "^3.4.9",
    "sanitize-html": "^2.17.5",
    "ws": "^8.18.0",
    "yjs": "^13.6.20"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.2",
    "@types/sanitize-html": "^2.16.1",
    "@types/ws": "^8.5.13",
    "y-protocols": "^1.0.6"
  },
  "keywords": [
    "llm",
    "ai",
    "build-system",
    "makefile",
    "markdown",
    "incremental",
    "content-addressed",
    "dag",
    "provenance"
  ],
  "homepage": "https://github.com/khoi03/makedown#readme",
  "bugs": "https://github.com/khoi03/makedown/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/khoi03/makedown.git",
    "directory": "apps/server"
  },
  "author": "khoi03"
}
