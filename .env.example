# Makedown workspace configuration.
#
# Copy this to `.env` IN YOUR WORKSPACE DIRECTORY (the folder containing build.md)
# and fill in the providers you use. Real environment variables that are already
# set take precedence over values here.
#
# Models are selected per-target in build.md using `provider:model`, e.g.
#   model: anthropic:claude-opus-4-8
#   model: openai:gpt-5
#   model: openai:meta-llama/llama-3.3-70b-instruct   (via OpenRouter)
# A bare model with no prefix (e.g. `claude-opus-4-8`) uses MAKEDOWN_DEFAULT_PROVIDER.

# --- Anthropic (default provider) ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# --- OpenAI-compatible: OpenAI, OpenRouter, Groq, Together, Ollama, vLLM, LM Studio ---
# Any endpoint that implements /chat/completions works here.
# OPENAI_API_KEY=sk-xxxxxxxx
# OPENAI_BASE_URL=https://api.openai.com/v1
#   OpenRouter:  https://openrouter.ai/api/v1
#   Groq:        https://api.groq.com/openai/v1
#   Together:    https://api.together.xyz/v1
#   Ollama:      http://localhost:11434/v1   (OPENAI_API_KEY can be any non-empty string)

# --- Provider for bare model names (no "provider:" prefix). Default: anthropic ---
# MAKEDOWN_DEFAULT_PROVIDER=anthropic
